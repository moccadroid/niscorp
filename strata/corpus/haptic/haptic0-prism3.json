    {
      "kind": "nisc.haptic/artifact",
      "id": "discovery-lua",
      "document": {
        "stamp": {
          "nisc.haptic": 0,
          "nisc.prism": 3
        },
        "policy": {
          "maxPages": 21,
          "maxRedirects": 3,
          "stripFragments": true,
          "accept": {
            "statuses": [
              200
            ]
          }
        },
        "stages": [
          {
            "kind": "records",
            "format": "html",
            "render": true,
            "selector": "a",
            "fields": {
              "url": {
                "selector": ":scope",
                "attribute": "href"
              }
            },
            "required": [
              "url"
            ],
            "where": null,
            "limit": null
          }
        ],
        "mapping": {
          "$map": {
            "over": {
              "$filter": {
                "over": {
                  "$ref": "$.records"
                },
                "as": "r",
                "when": {
                  "$contains": {
                    "value": {
                      "$get": {
                        "from": {
                          "$var": "r"
                        },
                        "path": [
                          "fields",
                          "url"
                        ]
                      }
                    },
                    "search": ".tar.gz"
                  }
                }
              }
            },
            "as": "rec",
            "body": {
              "url": {
                "$get": {
                  "from": {
                    "$var": "rec"
                  },
                  "path": [
                    "fields",
                    "url"
                  ]
                }
              }
            }
          }
        },
        "outputSchema": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "url": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          }
        }
      }
    },
