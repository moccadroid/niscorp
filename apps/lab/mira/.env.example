# Groq API key — gpt-oss-120b composes each answer (required)
GROQ_API_KEY=
# TypeSafe API key — Jev's pass over the message and the open screen, in about 200 ms; without it the chat model answers alone
TYPESAFE_API_KEY=

# The owner's email address: let in when the app starts, and the one who invites everybody else (required to sign in)
MIRA_OWNER=
# Resend API key — the sign-in links are mailed through it; without it each link is written to the server's log
RESEND_API_KEY=
# Who the mail is from; Resend's own address only reaches the account's own inbox, so a real domain goes here
MAIL_FROM=Mira <onboarding@resend.dev>
# The address people open the app at: a mailed link points here
PUBLIC_URL=http://localhost:5173

# Postgres (docker compose up -d); without it, an in-memory PGlite, gone when the app stops
DATABASE_URL=postgres://mira:mira@127.0.0.1:5434/mira
