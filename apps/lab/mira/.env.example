# Groq API key — gpt-oss-120b fills in each answer (required)
GROQ_API_KEY=
# TypeSafe API key — Jev picks an answer's parts in about 300 ms; without it the chat model picks, slower
TYPESAFE_API_KEY=
# Embeddings — for memory, and to narrow a catalog past 255 answers (openai | openrouter | none)
EMBEDDINGS=openai
# OpenAI API key — embeddings
OPENAI_API_KEY=
