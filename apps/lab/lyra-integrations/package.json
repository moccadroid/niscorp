{
  "name": "lyra-integrations",
  "private": true,
  "type": "module",
  "scripts": {
    "serve": "tsx src/serve.ts",
    "typecheck": "tsc --noEmit",
    "check": "turbo run build --filter=lyra-integrations^... && tsx src/dev/integration-check.ts && tsx src/dev/ledger-sql-check.ts",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:reset": "docker compose down -v && docker compose up -d --wait && pnpm migrate",
    "migrate": "node-pg-migrate up -m migrations -d DATABASE_URL",
    "migrate:down": "node-pg-migrate down -m migrations -d DATABASE_URL",
    "stripe:setup": "tsx src/setup.ts"
  },
  "dependencies": {
    "@niscorp/nova": "workspace:^",
    "hono": "^4.12.23",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.16.3",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.1",
    "@hono/node-server": "^2.0.4",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.4",
    "tsx": "^4.21.1",
    "typescript": "^6.0.2"
  }
}
