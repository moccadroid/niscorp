    "@niscorp/tide": "workspace:^",
    "@niscorp/vex": "workspace:^",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.4",
    "@niscorp/cli": "workspace:^",
    "@types/jsdom": "^30.0.0",
