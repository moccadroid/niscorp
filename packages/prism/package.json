{
  "name": "@niscorp/prism",
  "version": "0.1.0",
  "description": "Pure JSON transformation DSL with compilation and zero code execution",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./agent": {
      "import": {
        "types": "./dist/agent.d.ts",
        "default": "./dist/agent.js"
      },
      "require": {
        "types": "./dist/agent.d.cts",
        "default": "./dist/agent.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "bench": "vitest bench --run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "json",
    "transform",
    "mapping",
    "dsl",
    "llm",
    "typescript",
    "esm",
    "compile",
    "jq"
  ],
  "author": "niscorp",
  "repository": {
    "type": "git",
    "url": "https://github.com/moccadroid/niscorp.git",
    "directory": "packages/prism"
  },
  "homepage": "https://github.com/moccadroid/niscorp/tree/main/packages/prism",
  "bugs": {
    "url": "https://github.com/moccadroid/niscorp/issues"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "peerDependencies": {
    "@niscorp/cortex": "workspace:*",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@niscorp/cortex": {
      "optional": true
    }
  },
  "dependencies": {
    "dayjs": "^1.11.20"
  },
  "devDependencies": {
    "@niscorp/cortex": "workspace:*",
    "tsup": "^8.5.1",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  }
}
