{
  "name": "@niscorp/nova",
  "version": "0.1.0",
  "description": "Declarative UI framework for AI agents — JSON layouts, shell orchestration, React",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./adapters/react": {
      "import": {
        "types": "./dist/adapters/react/index.d.ts",
        "default": "./dist/adapters/react/index.js"
      },
      "require": {
        "types": "./dist/adapters/react/index.d.cts",
        "default": "./dist/adapters/react/index.cjs"
      }
    },
    "./adapters/react/components": {
      "import": {
        "types": "./dist/adapters/react/components/index.d.ts",
        "default": "./dist/adapters/react/components/index.js"
      },
      "require": {
        "types": "./dist/adapters/react/components/index.d.cts",
        "default": "./dist/adapters/react/components/index.cjs"
      }
    },
    "./adapters/dom": {
      "import": {
        "types": "./dist/adapters/dom/index.d.ts",
        "default": "./dist/adapters/dom/index.js"
      },
      "require": {
        "types": "./dist/adapters/dom/index.d.cts",
        "default": "./dist/adapters/dom/index.cjs"
      }
    },
    "./adapters/dom/components": {
      "import": {
        "types": "./dist/adapters/dom/components/index.d.ts",
        "default": "./dist/adapters/dom/components/index.js"
      },
      "require": {
        "types": "./dist/adapters/dom/components/index.d.cts",
        "default": "./dist/adapters/dom/components/index.cjs"
      }
    },
    "./agent": {
      "import": {
        "types": "./dist/agent/index.d.ts",
        "default": "./dist/agent/index.js"
      },
      "require": {
        "types": "./dist/agent/index.d.cts",
        "default": "./dist/agent/index.cjs"
      }
    },
    "./reflect": {
      "import": {
        "types": "./dist/reflect/index.d.ts",
        "default": "./dist/reflect/index.js"
      },
      "require": {
        "types": "./dist/reflect/index.d.cts",
        "default": "./dist/reflect/index.cjs"
      }
    },
    "./devtools": {
      "import": {
        "types": "./dist/devtools/index.d.ts",
        "default": "./dist/devtools/index.js"
      },
      "require": {
        "types": "./dist/devtools/index.d.cts",
        "default": "./dist/devtools/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@niscorp/cortex": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@niscorp/cortex": "workspace:*",
    "react": "^19.2.4",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "@niscorp/cortex": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
