{
  "name": "@niscorp/nova",
  "version": "0.1.0",
  "description": "Declarative UI framework for AI agents — JSON layouts, shell orchestration, React",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./react": {
      "import": { "types": "./dist/react/index.d.ts", "default": "./dist/react/index.js" },
      "require": { "types": "./dist/react/index.d.cts", "default": "./dist/react/index.cjs" }
    },
    "./components/react": {
      "import": { "types": "./dist/components/react.d.ts", "default": "./dist/components/react.js" },
      "require": { "types": "./dist/components/react.d.cts", "default": "./dist/components/react.cjs" }
    },
    "./agent": {
      "import": { "types": "./dist/agent/index.d.ts", "default": "./dist/agent/index.js" },
      "require": { "types": "./dist/agent/index.d.cts", "default": "./dist/agent/index.cjs" }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@niscorp/cortex": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^25.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@niscorp/cortex": "workspace:*",
    "react": "^19.2.4",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "@niscorp/cortex": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
