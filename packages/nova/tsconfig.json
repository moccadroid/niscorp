{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "paths": {
      "@shared": ["./src/shared"],
      "@shared/*": ["./src/shared/*"],
      "@action": ["./src/action"],
      "@action/*": ["./src/action/*"],
      "@layout": ["./src/layout"],
      "@layout/*": ["./src/layout/*"],
      "@shell": ["./src/shell"],
      "@shell/*": ["./src/shell/*"],
      "@react": ["./src/adapters/react"],
      "@react/*": ["./src/adapters/react/*"]
    }
  },
  "include": ["src"]
}
