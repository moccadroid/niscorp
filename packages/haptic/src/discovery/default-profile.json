{
  "provider": "groq",
  "modelTransport": {
    "openaiCompatible": { "maxRetries": 5 },
    "rateLimit": {
      "statuses": [429],
      "fallbackWaitMs": 1000,
      "code": "PROVIDER_RATE_LIMITED",
      "message": "The model provider remained rate-limited after the configured transport retries. Discovery is blocked, not semantically rejected."
    }
  },
  "outputRejections": [
    {
      "code": "output_parse_failed",
      "status": 400,
      "evidence": "The provider rejected the generated output before a usable answer was delivered. Return a fresh answer using the supplied output schema and finish protocol."
    }
  ],
  "settings": {
    "model": "openai/gpt-oss-120b",
    "reasoningEffort": "high",
    "temperature": 1,
    "topP": 1,
    "maxTokens": 16384,
    "maxSteps": 3,
    "outputAttempts": 3,
    "maxMs": 300000,
    "outputStrategy": "emit"
  },
  "outputSettings": { "reasoningEffort": "low" },
  "maxInputBytes": 524288,
  "authoring": {
    "minimumMatchesAcrossPages": 1,
    "allowOverlappingResults": true,
    "fieldBounds": { "minimum": 0, "maximum": null }
  },
  "review": { "maxModelSteps": 4, "maxModelMs": 60000, "maxRepairs": 1 },
  "minimumResultMatches": 0,
  "traversal": {
    "allowLinkFollowing": false,
    "linkDepth": 1,
    "maxPages": 4,
    "maxRedirects": 3,
    "stripFragments": true,
    "accept": { "statuses": [200], "mediaTypes": null }
  },
  "engine": {
    "maxSteps": 100000,
    "maxItems": 100000,
    "maxDepth": 128,
    "maxJsonDepth": 256,
    "maxActiveMs": 780000,
    "prism": { "maxSteps": 1000000, "maxStringLength": 2000000, "maxValues": 4000000 }
  },
  "trial": {
    "maxSteps": 100000,
    "maxItems": 100000,
    "maxDepth": 128,
    "maxJsonDepth": 256,
    "maxActiveMs": 30000,
    "prism": { "maxSteps": 1000000, "maxStringLength": 2000000, "maxValues": 4000000 }
  },
  "resources": {
    "allowResourceFetching": false,
    "maxResources": 4,
    "maxRedirects": 3,
    "stripFragments": true,
    "accept": { "statuses": [200], "mediaTypes": null }
  },
  "resultFlows": [
    {
      "flow": { "id": "fetch-resources", "revision": 1 },
      "description": "Fetch linked resources referenced by selected items, returning bytes and response metadata without content extraction."
    }
  ],
  "htmlContext": {
    "enabled": true,
    "policy": {
      "representation": "parsed-html",
      "clearTextIn": ["script", "style"],
      "clearAttributeValues": ["style"],
      "clearAttributeNamePrefixes": ["on"],
      "clearAttributeValuePrefixes": ["javascript:"],
      "clearContentsOf": ["svg"]
    },
    "maxInlineBytes": 262144,
    "initialInspection": {
      "selector": "*",
      "window": { "offset": 0, "limit": 20000 },
      "omitNested": true
    }
  },
  "formats": [
    {
      "id": "html",
      "mediaTypes": ["text/html", "application/xhtml+xml"],
      "mediaTypeSuffixes": [],
      "urlAttributes": ["href"]
    },
    { "id": "json", "mediaTypes": ["application/json"], "mediaTypeSuffixes": ["+json"] },
    {
      "id": "xml",
      "mediaTypes": ["application/xml", "text/xml"],
      "mediaTypeSuffixes": ["+xml"],
      "excludedMediaTypes": ["application/xhtml+xml"]
    }
  ],
  "diagnostics": {
    "maxBytes": 8192,
    "maxNodes": 3,
    "ancestorDepth": 3,
    "attributes": ["id", "class", "href", "role"],
    "attributePrefixes": ["data-"]
  },
  "author": { "maxModelSteps": 12, "maxResponseAttempts": 3, "maxModelMs": 300000 },
  "observations": { "maxBytes": 262144, "useScopedHtml": true, "skipRepeated": true }
}
