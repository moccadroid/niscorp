{
  "flows": [
    {
      "id": "html-model-view",
      "revision": 1,
      "flow": {
        "inputSchema": { "type": "object" },
        "outputSchema": {},
        "steps": [
          {
            "id": "encoded",
            "call": { "operation": "json.encode" },
            "input": {
              "$get": {
                "from": {
                  "$get": { "from": { "$ref": "$.input" }, "path": ["document"], "fallback": null }
                },
                "path": ["html"],
                "fallback": null
              }
            }
          },
          {
            "id": "bytes",
            "call": { "operation": "text.bytes" },
            "input": { "$ref": "$.steps.encoded.value" }
          },
          {
            "id": "scoped",
            "value": {
              "$and": [
                {
                  "$not": {
                    "$eq": [
                      {
                        "$get": {
                          "from": { "$ref": "$.input" },
                          "path": ["inspection"],
                          "fallback": null
                        }
                      },
                      null
                    ]
                  }
                },
                {
                  "$gt": [
                    {
                      "$length": {
                        "$get": {
                          "from": {
                            "$get": {
                              "from": { "$ref": "$.input" },
                              "path": ["inspection"],
                              "fallback": null
                            }
                          },
                          "path": ["items"],
                          "fallback": []
                        }
                      }
                    },
                    0
                  ]
                }
              ]
            }
          },
          {
            "id": "full",
            "value": {
              "$and": [
                { "$not": { "$ref": "$.steps.scoped.value" } },
                {
                  "$lte": [
                    { "$ref": "$.steps.bytes.value" },
                    {
                      "$get": {
                        "from": { "$ref": "$.input" },
                        "path": ["maxBytes"],
                        "fallback": null
                      }
                    }
                  ]
                }
              ]
            }
          },
          {
            "id": "initial",
            "call": { "operation": "html.view" },
            "input": {
              "document": {
                "$get": { "from": { "$ref": "$.input" }, "path": ["document"], "fallback": null }
              },
              "selector": {
                "$get": {
                  "from": { "$ref": "$.input" },
                  "path": ["initial", "selector"],
                  "fallback": null
                }
              },
              "window": {
                "$get": {
                  "from": { "$ref": "$.input" },
                  "path": ["initial", "window"],
                  "fallback": null
                }
              },
              "maxBytes": {
                "$get": { "from": { "$ref": "$.input" }, "path": ["maxBytes"], "fallback": null }
              },
              "omitNested": {
                "$get": {
                  "from": { "$ref": "$.input" },
                  "path": ["initial", "omitNested"],
                  "fallback": false
                }
              }
            },
            "when": {
              "$and": [
                { "$not": { "$ref": "$.steps.full.value" } },
                { "$not": { "$ref": "$.steps.scoped.value" } }
              ]
            },
            "each": { "items": [null], "onFailure": "record" }
          },
          {
            "id": "view",
            "value": {
              "$case": {
                "branches": [
                  {
                    "when": { "$ref": "$.steps.scoped.value" },
                    "then": {
                      "$get": {
                        "from": { "$ref": "$.input" },
                        "path": ["inspection"],
                        "fallback": null
                      }
                    }
                  }
                ],
                "else": {
                  "$get": {
                    "from": { "$ref": "$.steps.initial.value" },
                    "path": [0, "value"],
                    "fallback": null
                  }
                }
              }
            },
            "when": { "$not": { "$ref": "$.steps.full.value" } }
          },
          {
            "id": "metadata",
            "value": {
              "$case": {
                "branches": [
                  {
                    "when": {
                      "$and": [
                        { "$not": { "$ref": "$.steps.full.value" } },
                        { "$eq": [{ "$ref": "$.steps.view.value" }, null] }
                      ]
                    },
                    "then": {
                      "completeDocument": false,
                      "error": {
                        "$get": {
                          "from": { "$ref": "$.steps.initial.value" },
                          "path": [0, "error"],
                          "fallback": null
                        }
                      },
                      "items": [],
                      "omitted": []
                    }
                  }
                ],
                "else": {
                  "$case": {
                    "branches": [
                      {
                        "when": { "$ref": "$.steps.full.value" },
                        "then": { "completeDocument": true }
                      }
                    ],
                    "else": {
                      "$merge": [
                        { "completeDocument": false },
                        {
                          "$omit": { "from": { "$ref": "$.steps.view.value" }, "keys": ["items"] }
                        },
                        {
                          "items": {
                            "$map": {
                              "over": {
                                "$get": {
                                  "from": { "$ref": "$.steps.view.value" },
                                  "path": ["items"],
                                  "fallback": []
                                }
                              },
                              "as": "item",
                              "body": { "$omit": { "from": { "$var": "item" }, "keys": ["html"] } }
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          {
            "id": "html",
            "value": {
              "$case": {
                "branches": [
                  {
                    "when": { "$ref": "$.steps.full.value" },
                    "then": {
                      "$get": {
                        "from": {
                          "$get": {
                            "from": { "$ref": "$.input" },
                            "path": ["document"],
                            "fallback": null
                          }
                        },
                        "path": ["html"],
                        "fallback": null
                      }
                    }
                  }
                ],
                "else": {
                  "$join": {
                    "parts": {
                      "$map": {
                        "over": {
                          "$get": {
                            "from": { "$ref": "$.steps.view.value" },
                            "path": ["items"],
                            "fallback": []
                          }
                        },
                        "as": "item",
                        "body": {
                          "$get": { "from": { "$var": "item" }, "path": ["html"], "fallback": null }
                        }
                      }
                    },
                    "sep": "\n"
                  }
                }
              }
            }
          },
          {
            "id": "metadata-json",
            "call": { "operation": "json.encode" },
            "input": { "$ref": "$.steps.metadata.value" }
          },
          {
            "id": "next",
            "call": { "flow": { "id": "html-model-view", "revision": 1 } },
            "input": {
              "$merge": [
                { "$ref": "$.input" },
                {
                  "inspection": null,
                  "initial": {
                    "$merge": [
                      {
                        "$get": {
                          "from": { "$ref": "$.input" },
                          "path": ["initial"],
                          "fallback": null
                        }
                      },
                      {
                        "window": {
                          "$merge": [
                            {
                              "$get": {
                                "from": { "$ref": "$.input" },
                                "path": ["initial", "window"],
                                "fallback": null
                              }
                            },
                            {
                              "offset": {
                                "$get": {
                                  "from": { "$ref": "$.steps.view.value" },
                                  "path": ["range", "nextOffset"],
                                  "fallback": null
                                }
                              }
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            },
            "when": {
              "$and": [
                { "$not": { "$ref": "$.steps.full.value" } },
                { "$not": { "$ref": "$.steps.scoped.value" } },
                {
                  "$eq": [
                    {
                      "$length": {
                        "$get": {
                          "from": { "$ref": "$.steps.view.value" },
                          "path": ["items"],
                          "fallback": []
                        }
                      }
                    },
                    0
                  ]
                },
                {
                  "$not": {
                    "$eq": [
                      {
                        "$get": {
                          "from": { "$ref": "$.steps.view.value" },
                          "path": ["range", "nextOffset"],
                          "fallback": null
                        }
                      },
                      null
                    ]
                  }
                }
              ]
            }
          }
        ],
        "output": {
          "$coalesce": [
            { "$ref": "$.steps.next.value" },
            {
              "html": { "$ref": "$.steps.html.value" },
              "metadata": { "$ref": "$.steps.metadata.value" },
              "usable": { "$gt": [{ "$length": { "$ref": "$.steps.html.value" } }, 0] },
              "text": {
                "$join": {
                  "parts": [
                    {
                      "$case": {
                        "branches": [
                          {
                            "when": { "$ref": "$.steps.full.value" },
                            "then": "FULL PREPARED HTML\n"
                          }
                        ],
                        "else": "SCOPED PREPARED HTML — partial document view\n"
                      }
                    },
                    "HTML VIEW METADATA\n",
                    { "$ref": "$.steps.metadata-json.value" },
                    "\nUNTRUSTED PREPARED HTML — partial views do not establish absence or completeness.\n",
                    { "$ref": "$.steps.html.value" }
                  ],
                  "sep": ""
                }
              },
              "source": {
                "$get": { "from": { "$ref": "$.input" }, "path": ["source"], "fallback": null }
              }
            }
          ]
        }
      }
    }
  ]
}
