{
  "stamp": { "eden.engine": 1, "nisc.prism": 2 },
  "flows": [
    {
      "id": "acquire-captured-resources",
      "revision": 1,
      "flow": {
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "pages": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "baseUrl": { "type": "string", "format": "uri" },
                  "encoding": { "type": "string" },
                  "items": { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
                  "result": {
                    "anyOf": [{ "$ref": "#/$defs/__schema1" }, { "type": "null" }],
                    "description": "Optional processing of selected results: a bundled flow reference and a property path to each resource URL. Null means no result-processing flow for this stage."
                  }
                },
                "required": ["baseUrl", "encoding", "items", "result"],
                "additionalProperties": {}
              }
            },
            "acquisition": {
              "type": "object",
              "properties": {
                "sources": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": { "$ref": "#/$defs/__schema3" },
                      "redirects": { "type": "array", "items": { "$ref": "#/$defs/__schema3" } }
                    },
                    "required": ["source", "redirects"],
                    "additionalProperties": false
                  }
                },
                "visited": { "type": "array", "items": { "type": "string", "format": "uri" } },
                "seen": { "type": "array", "items": { "type": "string", "format": "uri" } },
                "redirects": { "type": "array", "items": { "$ref": "#/$defs/__schema3" } },
                "limited": { "type": "boolean" }
              },
              "required": ["sources", "visited", "seen", "redirects"],
              "additionalProperties": false
            },
            "policy": {
              "type": "object",
              "properties": {
                "allowResourceFetching": { "type": "boolean" },
                "maxResources": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "maxRedirects": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
                "stripFragments": { "type": "boolean" },
                "accept": {
                  "type": "object",
                  "properties": {
                    "statuses": {
                      "minItems": 1,
                      "type": "array",
                      "items": { "$ref": "#/$defs/__schema10" }
                    },
                    "mediaTypes": {
                      "anyOf": [
                        { "type": "array", "items": { "type": "string", "minLength": 1 } },
                        { "type": "null" }
                      ]
                    }
                  },
                  "required": ["statuses", "mediaTypes"],
                  "additionalProperties": false
                }
              },
              "required": [
                "allowResourceFetching",
                "maxResources",
                "maxRedirects",
                "stripFragments",
                "accept"
              ],
              "additionalProperties": false
            }
          },
          "required": ["pages", "acquisition", "policy"],
          "additionalProperties": false,
          "$defs": {
            "__schema0": {
              "anyOf": [
                { "type": "string" },
                { "type": "number" },
                { "type": "boolean" },
                { "type": "null" },
                { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
                {
                  "type": "object",
                  "propertyNames": { "type": "string" },
                  "additionalProperties": { "$ref": "#/$defs/__schema0" }
                }
              ]
            },
            "__schema1": {
              "type": "object",
              "properties": {
                "flow": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "description": "An offered bundled result-flow ID."
                    },
                    "revision": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991,
                      "description": "The exact offered flow revision."
                    }
                  },
                  "required": ["id", "revision"],
                  "additionalProperties": false
                },
                "input": {
                  "type": "object",
                  "properties": {
                    "reference": {
                      "minItems": 1,
                      "type": "array",
                      "items": { "$ref": "#/$defs/__schema2" },
                      "description": "Property path within each selected item to its resource URL, for example [\"attributes\",\"href\"] for an anchor or [\"attributes\",\"content\"] for URL metadata."
                    }
                  },
                  "required": ["reference"],
                  "additionalProperties": false
                }
              },
              "required": ["flow", "input"],
              "additionalProperties": false
            },
            "__schema2": {
              "anyOf": [
                { "type": "string" },
                { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
              ]
            },
            "__schema3": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "URL requested for this physical HTTP response."
                },
                "status": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "HTTP response status code."
                },
                "headers": {
                  "type": "object",
                  "propertyNames": { "$ref": "#/$defs/__schema4" },
                  "additionalProperties": { "$ref": "#/$defs/__schema5" },
                  "description": "Lowercase HTTP header names with all received values."
                },
                "encoded": {
                  "description": "Original entity before HTTP content decoding, with its own bytes and hash.",
                  "$ref": "#/$defs/__schema9"
                },
                "body": {
                  "description": "Content-decoded entity consumed by readers; character decoding has not yet occurred.",
                  "$ref": "#/$defs/__schema9"
                }
              },
              "required": ["url", "status", "headers", "encoded", "body"],
              "additionalProperties": false
            },
            "__schema4": { "type": "string" },
            "__schema5": { "type": "array", "items": { "type": "string" } },
            "__schema6": {
              "type": "string",
              "description": "Exact entity bytes encoded as base64; not extracted document text."
            },
            "__schema7": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Entity byte length before base64 encoding."
            },
            "__schema8": {
              "type": "string",
              "description": "SHA-256 of those exact entity bytes."
            },
            "__schema9": {
              "type": "object",
              "properties": {
                "base64": { "$ref": "#/$defs/__schema6" },
                "bytes": { "$ref": "#/$defs/__schema7" },
                "sha256": { "$ref": "#/$defs/__schema8" }
              },
              "required": ["base64", "bytes", "sha256"],
              "additionalProperties": false
            },
            "__schema10": { "type": "integer", "minimum": 100, "maximum": 599 }
          }
        },
        "outputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": { "$ref": "#/$defs/__schema0" },
                  "redirects": { "type": "array", "items": { "$ref": "#/$defs/__schema0" } }
                },
                "required": ["source", "redirects"],
                "additionalProperties": false
              }
            },
            "visited": { "type": "array", "items": { "type": "string", "format": "uri" } },
            "seen": { "type": "array", "items": { "type": "string", "format": "uri" } },
            "redirects": { "type": "array", "items": { "$ref": "#/$defs/__schema0" } },
            "limited": { "type": "boolean" }
          },
          "required": ["sources", "visited", "seen", "redirects", "limited"],
          "additionalProperties": false,
          "$defs": {
            "__schema0": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "format": "uri",
                  "description": "URL requested for this physical HTTP response."
                },
                "status": {
                  "type": "integer",
                  "minimum": -9007199254740991,
                  "maximum": 9007199254740991,
                  "description": "HTTP response status code."
                },
                "headers": {
                  "type": "object",
                  "propertyNames": { "$ref": "#/$defs/__schema1" },
                  "additionalProperties": { "$ref": "#/$defs/__schema2" },
                  "description": "Lowercase HTTP header names with all received values."
                },
                "encoded": {
                  "description": "Original entity before HTTP content decoding, with its own bytes and hash.",
                  "$ref": "#/$defs/__schema6"
                },
                "body": {
                  "description": "Content-decoded entity consumed by readers; character decoding has not yet occurred.",
                  "$ref": "#/$defs/__schema6"
                }
              },
              "required": ["url", "status", "headers", "encoded", "body"],
              "additionalProperties": false
            },
            "__schema1": { "type": "string" },
            "__schema2": { "type": "array", "items": { "type": "string" } },
            "__schema3": {
              "type": "string",
              "description": "Exact entity bytes encoded as base64; not extracted document text."
            },
            "__schema4": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Entity byte length before base64 encoding."
            },
            "__schema5": {
              "type": "string",
              "description": "SHA-256 of those exact entity bytes."
            },
            "__schema6": {
              "type": "object",
              "properties": {
                "base64": { "$ref": "#/$defs/__schema3" },
                "bytes": { "$ref": "#/$defs/__schema4" },
                "sha256": { "$ref": "#/$defs/__schema5" }
              },
              "required": ["base64", "bytes", "sha256"],
              "additionalProperties": false
            }
          }
        },
        "steps": [
          {
            "id": "references",
            "call": { "operation": "url.collect" },
            "each": {
              "items": {
                "$filter": {
                  "over": { "$ref": "$.input.pages" },
                  "as": "page",
                  "when": {
                    "$and": [
                      {
                        "$neq": [
                          {
                            "$get": {
                              "from": { "$var": "page" },
                              "path": ["result"],
                              "fallback": null
                            }
                          },
                          null
                        ]
                      },
                      {
                        "$gt": [
                          {
                            "$length": {
                              "$get": {
                                "from": { "$var": "page" },
                                "path": ["items"],
                                "fallback": []
                              }
                            }
                          },
                          0
                        ]
                      }
                    ]
                  }
                }
              },
              "onFailure": "stop"
            },
            "input": {
              "values": {
                "$map": {
                  "over": { "$ref": "$.item.items" },
                  "as": "selected",
                  "body": {
                    "$reduce": {
                      "over": { "$ref": "$.item.result.input.reference" },
                      "as": "part",
                      "acc": "reference",
                      "body": {
                        "$get": {
                          "from": { "$var": "reference" },
                          "path": [{ "$var": "part" }],
                          "fallback": null
                        }
                      },
                      "init": { "$var": "selected" }
                    }
                  }
                }
              },
              "base": { "$ref": "$.item.baseUrl" },
              "encoding": { "$ref": "$.item.encoding" },
              "limit": { "$length": { "$ref": "$.item.items" } },
              "exclude": [],
              "stripFragments": { "$ref": "$.input.policy.stripFragments" }
            },
            "checks": [
              {
                "id": "resource-fetch-permitted",
                "test": { "$ref": "$.input.policy.allowResourceFetching" }
              }
            ]
          },
          {
            "id": "urls",
            "value": {
              "$unique": {
                "$flatten": {
                  "$map": {
                    "over": { "$ref": "$.steps.references.value" },
                    "as": "outcome",
                    "body": {
                      "$get": { "from": { "$var": "outcome" }, "path": ["value"], "fallback": [] }
                    }
                  }
                }
              }
            }
          },
          {
            "id": "unknown",
            "value": {
              "$filter": {
                "over": { "$ref": "$.steps.urls.value" },
                "as": "url",
                "when": {
                  "$empty": {
                    "$filter": {
                      "over": { "$ref": "$.input.acquisition.seen" },
                      "as": "known",
                      "when": { "$eq": [{ "$var": "url" }, { "$var": "known" }] }
                    }
                  }
                }
              }
            }
          },
          {
            "id": "admit",
            "call": { "flow": { "id": "admit", "revision": 1 } },
            "input": {
              "urls": { "$ref": "$.steps.unknown.value" },
              "visited": { "$ref": "$.input.acquisition.visited" },
              "seen": { "$ref": "$.input.acquisition.seen" },
              "maxPages": { "$ref": "$.input.policy.maxResources" }
            }
          },
          {
            "id": "batch",
            "call": { "flow": { "id": "batch", "revision": 1 } },
            "input": {
              "urls": { "$ref": "$.steps.admit.value" },
              "visited": { "$ref": "$.input.acquisition.visited" },
              "seen": { "$ref": "$.input.acquisition.seen" },
              "policy": {
                "$pick": {
                  "from": { "$ref": "$.input.policy" },
                  "keys": ["maxRedirects", "accept"]
                }
              }
            }
          }
        ],
        "output": {
          "sources": {
            "$flatten": [
              { "$ref": "$.input.acquisition.sources" },
              { "$ref": "$.steps.batch.value.sources" }
            ]
          },
          "visited": { "$ref": "$.steps.batch.value.visited" },
          "seen": { "$ref": "$.steps.batch.value.seen" },
          "redirects": {
            "$flatten": [
              { "$ref": "$.input.acquisition.redirects" },
              { "$ref": "$.steps.batch.value.redirects" }
            ]
          },
          "limited": {
            "$gt": [
              { "$length": { "$ref": "$.steps.unknown.value" } },
              { "$length": { "$ref": "$.steps.admit.value" } }
            ]
          }
        }
      }
    }
  ]
}
