{
  "cases": [
    {
      "id": "django-news",
      "url": "https://www.djangoproject.com/weblog/",
      "instruction": "Return every news entry from the main weblog list, including featured entries, in document order. For each entry return its headline and introductory paragraph text, trimming surrounding whitespace. Exclude author/date bylines, Read more labels, navigation, sidebar and footer content.",
      "expectedSelector": "ul.list-news > li",
      "outputSchema": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "headline": {
              "type": "string",
              "description": "News entry headline text, with surrounding whitespace removed."
            },
            "intro": {
              "type": "string",
              "description": "Introductory paragraph of the same news entry, with surrounding whitespace removed; excludes byline and Read more text."
            }
          },
          "required": [
            "headline",
            "intro"
          ],
          "additionalProperties": false
        }
      },
      "expectedFields": {
        "title": {
          "selector": ":scope > h2",
          "attribute": null,
          "minimum": 1,
          "maximum": 1
        },
        "introductory": {
          "selector": ":scope > p",
          "attribute": null,
          "minimum": 1,
          "maximum": 1
        }
      },
      "expectedMetadata": {
        "visited": [
          "https://www.djangoproject.com/weblog/"
        ],
        "limited": false
      },
      "expectedMapping": {
        "$map": {
          "over": {
            "$ref": "$.input.pages[0].items"
          },
          "as": "record",
          "body": {
            "headline": {
              "$trim": {
                "$get": {
                  "from": {
                    "$var": "record"
                  },
                  "path": [
                    "fields",
                    "title",
                    0
                  ]
                }
              }
            },
            "intro": {
              "$trim": {
                "$get": {
                  "from": {
                    "$var": "record"
                  },
                  "path": [
                    "fields",
                    "introductory",
                    0
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "sqlite-release-notes",
      "url": "https://www.sqlite.org/chronology.html",
      "instruction": "Visit the three most recent release-note pages linked from this chronology. Select each page's main release heading and all its top-level ordered change lists, including lists of earlier changes and nested entries. Exclude navigation and footer elements.",
      "expectedSelector": "table td a[href^='releaselog/']",
      "expectedDestinationSelector": "h2, ol.lessindent",
      "checkContent": true,
      "allowLinkFollowing": true,
      "linkDepth": 1,
      "maxPages": 4
    }
  ]
}
