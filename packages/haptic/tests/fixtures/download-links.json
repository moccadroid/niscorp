{
  "stamp": {"eden.engine": 0, "nisc.prism": 2},
  "flow": {
    "inputSchema": {"type": "object", "properties": {"url": {"type": "string"}}, "required": ["url"], "additionalProperties": false},
    "outputSchema": {"type": "array"},
    "steps": [
      {"id": "page", "call": {"operation": "http.get"}, "input": {"url": {"$ref": "$.input.url"}},
        "checks": [{"id": "page-ok", "test": {"$eq": [{"$ref": "$.value.status"}, 200]}}]},
      {"id": "links", "call": {"operation": "html.select"}, "input": {
        "source": {"$ref": "$.steps.page.value"}, "selector": "main[data-list] a[data-file]"}},
      {"id": "downloads", "call": {"flow": {"id": "download", "revision": 1}},
        "each": {"items": {"$ref": "$.steps.links.value.items"}, "onFailure": "stop"},
        "input": {"link": {"$ref": "$.item"}, "base": {"$ref": "$.steps.links.value.baseUrl"}, "encoding": {"$ref": "$.steps.links.value.encoding"}}}
    ],
    "output": {"$ref": "$.steps.downloads.value"}
  },
  "flows": [
    {"id": "download", "revision": 1, "flow": {
      "inputSchema": {"type": "object"}, "outputSchema": {"type": "object"},
      "steps": [
        {"id": "url", "call": {"operation": "url.resolve"}, "input": {
          "value": {"$ref": "$.input.link.attributes.href"}, "base": {"$ref": "$.input.base"}, "encoding": {"$ref": "$.input.encoding"}}},
        {"id": "file", "call": {"operation": "http.get"}, "input": {"url": {"$ref": "$.steps.url.value"}},
          "checks": [{"id": "file-ok", "test": {"$eq": [{"$ref": "$.value.status"}, 200]}}]}
      ],
      "output": {"url": {"$ref": "$.steps.file.value.url"}, "encoded": {"$ref": "$.steps.file.value.encoded"}, "body": {"$ref": "$.steps.file.value.body"}}
    }}
  ]
}
