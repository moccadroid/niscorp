{
  "stamp": {
    "eden.engine": 0,
    "nisc.prism": 2
  },
  "flow": {
    "inputSchema": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["url"],
      "additionalProperties": false
    },
    "outputSchema": {
      "type": "object"
    },
    "steps": [
      {
        "id": "page",
        "call": {
          "flow": {
            "id": "fetch",
            "revision": 2
          }
        },
        "input": {
          "url": {
            "$ref": "$.input.url"
          },
          "remaining": 3,
          "seen": [
            {
              "$ref": "$.input.url"
            }
          ],
          "accept": {
            "statuses": [200],
            "mediaTypes": ["text/html", "application/xhtml+xml"]
          }
        }
      },
      {
        "id": "links",
        "call": {
          "operation": "html.select"
        },
        "input": {
          "source": {
            "$ref": "$.steps.page.value.source"
          },
          "selector": "meta[name='citation_pdf_url']"
        },
        "checks": [
          {
            "id": "pdf-link-present",
            "test": {
              "$gt": [
                {
                  "$length": {
                    "$ref": "$.value.items"
                  }
                },
                0
              ]
            }
          },
          {
            "id": "selection-bounded",
            "test": {
              "$lte": [
                {
                  "$length": {
                    "$ref": "$.value.items"
                  }
                },
                3
              ]
            }
          }
        ]
      },
      {
        "id": "urls",
        "call": {
          "operation": "url.resolve"
        },
        "each": {
          "items": {
            "$ref": "$.steps.links.value.items"
          },
          "onFailure": "stop"
        },
        "input": {
          "value": {
            "$ref": "$.item.attributes.content"
          },
          "base": {
            "$ref": "$.steps.links.value.baseUrl"
          },
          "encoding": {
            "$ref": "$.steps.links.value.encoding"
          }
        }
      },
      {
        "id": "files",
        "call": {
          "flow": {
            "id": "fetch",
            "revision": 2
          }
        },
        "each": {
          "items": {
            "$ref": "$.steps.urls.value"
          },
          "onFailure": "stop"
        },
        "input": {
          "url": {
            "$ref": "$.item.value"
          },
          "remaining": 3,
          "seen": [
            {
              "$ref": "$.item.value"
            }
          ],
          "accept": {
            "statuses": [200],
            "mediaTypes": ["application/pdf"]
          }
        }
      }
    ],
    "output": {
      "page": {
        "$ref": "$.steps.page.value.source"
      },
      "redirects": {
        "$ref": "$.steps.page.value.redirects"
      },
      "links": {
        "$ref": "$.steps.links.value"
      },
      "files": {
        "$pluck": {
          "over": {
            "$ref": "$.steps.files.value"
          },
          "key": "value"
        }
      }
    }
  },
  "flows": []
}
