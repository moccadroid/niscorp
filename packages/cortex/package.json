{
  "name": "@niscorp/cortex",
  "version": "0.1.0",
  "description": "Agent runtime — one tool loop, typed envelopes, gates, streamed events",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/moccadroid/niscorp.git",
    "directory": "packages/cortex"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "*.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@niscorp/solid": "workspace:*"
  },
  "peerDependencies": {
    "@niscorp/signal": "workspace:^",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@niscorp/signal": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "vitest": "^4.1.2",
    "zod": "^4.6.5"
  }
}
