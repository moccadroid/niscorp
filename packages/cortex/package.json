{
  "name": "@niscorp/cortex",
  "version": "0.1.0",
  "description": "Agentic orchestration runtime — agents, tools, behaviors, plans",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.examples.json",
    "scratch": "tsx examples/scratch.ts"
  },
  "devDependencies": {
    "@niscorp/prism": "workspace:*",
    "@niscorp/signal": "workspace:*",
    "@types/node": "^22.10.2",
    "tsup": "^8.5.1",
    "tsx": "^4.19.2",
    "vitest": "^4.1.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "@niscorp/signal": "workspace:*",
    "zod": "^4.3.6"
  }
}
