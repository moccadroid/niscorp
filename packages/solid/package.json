{
  "name": "@niscorp/solid",
  "version": "0.1.0",
  "description": "Structured Output Live Inference Decoding \u00e2\u20ac\u201d always-valid schema-backed object stream over partial JSON",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "llm",
    "streaming",
    "json",
    "structured-output",
    "zod",
    "typescript",
    "partial-json",
    "schema"
  ],
  "author": "niscorp",
  "repository": {
    "type": "git",
    "url": "https://github.com/moccadroid/niscorp.git",
    "directory": "packages/solid"
  },
  "homepage": "https://github.com/moccadroid/niscorp/tree/main/packages/solid",
  "bugs": {
    "url": "https://github.com/moccadroid/niscorp/issues"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "vitest": "^4.1.2"
  }
}
