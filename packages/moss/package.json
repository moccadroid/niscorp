{
  "name": "@niscorp/moss",
  "version": "0.1.0",
  "description": "moss — the nisc app server: serves existence (catalog, scoped vex, the socket), derived from artifacts",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "require": "./dist/node.cjs"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js",
      "require": "./dist/client.cjs"
    },
    "./client/node": {
      "types": "./dist/client/node.d.ts",
      "import": "./dist/client/node.js",
      "require": "./dist/client/node.cjs"
    },
    "./terminal": {
      "types": "./dist/terminal/index.d.ts",
      "import": "./dist/terminal/index.js",
      "require": "./dist/terminal/index.cjs"
    },
    "./terminal/react": {
      "types": "./dist/terminal/react/index.d.ts",
      "import": "./dist/terminal/react/index.js",
      "require": "./dist/terminal/react/index.cjs"
    },
    "./terminal/dom": {
      "types": "./dist/terminal/dom/index.d.ts",
      "import": "./dist/terminal/dom/index.js",
      "require": "./dist/terminal/dom/index.cjs"
    },
    "./terminal/tty": {
      "types": "./dist/terminal/tty/index.d.ts",
      "import": "./dist/terminal/tty/index.js",
      "require": "./dist/terminal/tty/index.cjs"
    },
    "./terminal/ink": {
      "types": "./dist/terminal/ink/index.d.ts",
      "import": "./dist/terminal/ink/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.4",
    "@niscorp/charter": "workspace:^",
    "@niscorp/nova": "workspace:^",
    "@niscorp/prism": "workspace:^",
    "@niscorp/vex": "workspace:^",
    "hono": "^4.12.23",
    "ws": "^8.21.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "ink": "^7.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "peerDependenciesMeta": {
    "ink": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "ink": "^7.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
