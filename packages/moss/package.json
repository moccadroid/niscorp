{
  "name": "@niscorp/moss",
  "version": "0.3.2",
  "description": "moss — the nisc app server: serves existence (catalog, scoped vex, the socket), derived from artifacts",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/moccadroid/niscorp.git",
    "directory": "packages/moss"
  },
