    "@niscorp/tide": "workspace:^",
    "@niscorp/vex": "workspace:^",
    "ink": "^7.1.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.2.0",
    "vue": "^3.5.0",
    "vite": ">=6"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    },
    "ink": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.1",
    "@niscorp/charter": "workspace:^",
    "@niscorp/nova": "workspace:^",
    "@niscorp/prism": "workspace:^",
    "@niscorp/strata": "workspace:^",
    "@niscorp/tide": "workspace:^",
    "@niscorp/vex": "workspace:^",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "ink": "^7.1.1",
    "jsdom": "^25.0.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vite": "^7.1.12",
    "vitest": "^4.1.2",
    "vue": "^3.5.43",
    "zod": "^4.6.5"
  }
