{
  "name": "@niscorp/strata",
  "version": "0.1.3",
  "description": "Migrations for nisc \u2014 one ledger for the tables a database holds and the documents stored in them, applied in order, recorded once, refused when edited.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/moccadroid/niscorp.git",
    "directory": "packages/strata"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./postgres": {
      "import": {
        "types": "./dist/postgres/index.d.ts",
        "default": "./dist/postgres/index.js"
      },
      "require": {
        "types": "./dist/postgres/index.d.cts",
        "default": "./dist/postgres/index.cjs"
      }
    },
    "./check": {
      "import": {
        "types": "./dist/check/index.d.ts",
        "default": "./dist/check/index.js"
      },
      "require": {
        "types": "./dist/check/index.d.cts",
        "default": "./dist/check/index.cjs"
      }
    },
    "./upgrade": {
      "import": {
        "types": "./dist/upgrade/index.d.ts",
        "default": "./dist/upgrade/index.js"
      },
      "require": {
        "types": "./dist/upgrade/index.d.cts",
        "default": "./dist/upgrade/index.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node/index.d.ts",
        "default": "./dist/node/index.js"
      },
      "require": {
        "types": "./dist/node/index.d.cts",
        "default": "./dist/node/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "*.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2",
    "zod": "^4.6.5",
    "@types/node": "^22"
  }
}
