{
  "name": "@niscorp/vex",
  "version": "0.1.0",
  "description": "Declarative query synthesis — intent to SQL with caching and scope policies",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/moccadroid/niscorp.git",
    "directory": "packages/vex"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./agent": {
      "import": {
        "types": "./dist/agent/index.d.ts",
        "default": "./dist/agent/index.js"
      },
      "require": {
        "types": "./dist/agent/index.d.cts",
        "default": "./dist/agent/index.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/adapters/hono/index.d.ts",
        "default": "./dist/adapters/hono/index.js"
      },
      "require": {
        "types": "./dist/adapters/hono/index.d.cts",
        "default": "./dist/adapters/hono/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/adapters/express/index.d.ts",
        "default": "./dist/adapters/express/index.js"
      },
      "require": {
        "types": "./dist/adapters/express/index.d.cts",
        "default": "./dist/adapters/express/index.cjs"
      }
    },
    "./pglite": {
      "import": {
        "types": "./dist/adapters/pglite/index.d.ts",
        "default": "./dist/adapters/pglite/index.js"
      },
      "require": {
        "types": "./dist/adapters/pglite/index.d.cts",
        "default": "./dist/adapters/pglite/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "*.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "seed": "tsup && tsx scripts/seed.ts",
    "dev:server": "docker compose up -d --wait && tsup && tsx watch --env-file=.env scripts/dev.ts",
    "test:queries": "tsx scripts/test-queries.ts",
    "generate:embeddings": "tsx --env-file=.env scripts/generate-embeddings.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "peerDependencies": {
    "@niscorp/cortex": "workspace:^",
    "@niscorp/prism": "workspace:^",
    "@niscorp/strata": "workspace:^",
    "hono": "^4",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.1",
    "@hono/node-server": "^2.0.4",
    "@niscorp/cortex": "workspace:^",
    "@niscorp/prism": "workspace:^",
    "@niscorp/strata": "workspace:^",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.15.4",
    "hono": "^4.12.23",
    "pg": "^8.16.3",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3",
    "vitest": "^4.1.2",
    "zod": "^4.6.5"
  },
  "peerDependenciesMeta": {
    "@niscorp/cortex": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
