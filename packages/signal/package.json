{
  "name": "@niscorp/signal",
  "version": "0.1.0",
  "description": "Universal LLM abstraction \u00e2\u20ac\u201d stateless, immutable, provider-agnostic",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json"
  },
  "keywords": [
    "llm",
    "ai",
    "openai",
    "groq",
    "anthropic",
    "provider",
    "structured-output",
    "zod",
    "typescript",
    "tools"
  ],
  "author": "niscorp",
  "repository": {
    "type": "git",
    "url": "https://github.com/moccadroid/niscorp.git",
    "directory": "packages/signal"
  },
  "homepage": "https://github.com/moccadroid/niscorp/tree/main/packages/signal",
  "bugs": {
    "url": "https://github.com/moccadroid/niscorp/issues"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "dotenv": "^17.4.0",
    "openai": "^6.33.0",
    "tsup": "^8.5.1",
    "vitest": "^4.1.2"
  }
}
