{
  "name": "@niscorp/signal",
  "version": "0.1.2",
  "description": "Universal LLM abstraction — stateless, immutable, provider-agnostic",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "*.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "probe": "tsx --env-file=.env scripts/probe-model.ts"
  },
  "keywords": [
    "llm",
    "ai",
    "openai",
    "groq",
    "anthropic",
    "provider",
    "structured-output",
    "zod",
    "typescript",
    "tools"
  ],
  "author": "niscorp",
  "repository": {
    "type": "git",
    "url": "https://github.com/moccadroid/niscorp.git",
    "directory": "packages/signal"
  },
  "homepage": "https://github.com/moccadroid/niscorp/tree/main/packages/signal",
  "bugs": {
    "url": "https://github.com/moccadroid/niscorp/issues"
  },
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "dotenv": "^17.4.0",
    "openai": "^6.33.0",
    "tsup": "^8.5.1",
    "tsx": "^4.20.3",
    "vitest": "^4.1.2",
    "zod": "^4.6.5"
  }
}
